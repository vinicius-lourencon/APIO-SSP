# Copie para .env e ajuste. O servidor carrega o .env automaticamente (dotenv).

# Segredo usado para assinar os tokens JWT.
# Obrigatório no `pnpm start` (produção local). No `pnpm dev` existe um segredo de desenvolvimento.
# Gere um valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Porta do `pnpm start` (padrão 3000). O `pnpm dev` usa sempre a 8080.
PORT=3000

# Usuários e projetos de demonstração (senha "senha123") são criados com o banco vazio no `pnpm dev`.
# No `pnpm start` (produção) só com SEED=1.
SEED=

# ── E-mail (solicitação de reunião) ──────────────────────────────────────────
# Gmail: use uma conta com verificação em 2 etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (16 letras; NÃO é a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true para a porta 465 (SSL); false para 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Remetente exibido. No Gmail o endereço precisa ser o próprio SMTP_USER.
# Ex.: SISAPA <sisapa.ifms@gmail.com>. Vazio = usa SMTP_USER.
MAIL_FROM=

# Sem SMTP_USER/SMTP_PASS: no `pnpm dev` o e-mail é só impresso no terminal (não é enviado);
# no `pnpm start` a API responde 503 "envio de e-mail não configurado".
# EMAIL_TRANSPORT=log força o modo de terminal mesmo com SMTP configurado.
EMAIL_TRANSPORT=

# Testes: envia TODOS os e-mails para este endereço (o destinatário original vai no assunto).
# Use enquanto testa com os usuários de demonstração, cujos e-mails podem ser de pessoas reais.
EMAIL_REDIRECT_TO=

# Origens extras liberadas no CORS, separadas por vírgula (ex.: http://meu-pc:5173).
# Requisições da mesma origem, e de localhost/127.0.0.1/[::1] fora de produção, já são aceitas.
CORS_ORIGINS=
